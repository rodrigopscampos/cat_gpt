{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug FastAPI via Uvicorn",
      "type": "debugpy",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "openwebui.api:app",
        "--reload",
        "--port",
        "8000"
      ],
      "python": "${command:python.interpreterPath}",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      }
    }
  ]
}